# Copy to backend/.env (git-ignored) and fill in what you need.
# The backend loads it on start; variables already set in the shell win.

# development | test | production (production refuses to start: no identity provider yet)
PLUME_ENV=development
# Enables the published demo accounts (<org>@plume.demo / plume-demo-2040), loopback only.
PLUME_DEMO_AUTH=true

# Optional language model for the copilot briefing. Without a key, an offline
# template is used and everything else works.
# PLUME_LLM_PROVIDER=openai        # or: anthropic (default: whichever key is set)
# OPENAI_API_KEY=
# PLUME_OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# PLUME_LLM_MODEL=claude-opus-5-5

# Per-organization quota on language-model requests (template answers are free).
# PLUME_AI_PER_MINUTE=20
# PLUME_AI_PER_DAY=200

# Extra origins allowed to call the API (comma-separated, no wildcard).
# PLUME_CORS_ORIGINS=http://localhost:5174,http://localhost:5173
